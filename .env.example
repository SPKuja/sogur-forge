# Sögur Forge self-hosting / Portainer stack settings
APP_PORT=3000
APP_URL=http://localhost:3000

# Required. Generate unique long random values before deployment.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes

# Optional. Override this to pin a release instead of tracking latest.
SOGUR_FORGE_IMAGE=ghcr.io/spkuja/sogur-forge:latest
