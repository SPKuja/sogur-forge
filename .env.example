# Sögur Forge self-hosting / Portainer stack settings
APP_PORT=3000
APP_URL=http://localhost:3000

# Secrets are generated automatically on first deployment and persisted.
# Advanced users may uncomment these to supply their own values on FIRST deployment.
# POSTGRES_PASSWORD=replace-with-a-long-random-password
# AUTH_SECRET=replace-with-at-least-32-random-bytes

# Optional. Override this to pin a release instead of tracking latest.
SOGUR_FORGE_IMAGE=ghcr.io/spkuja/sogur-forge:latest

# A recovery copy of the generated secrets is stored in the
# sogur_forge_recovery volume as sogur-forge-recovery.env.
# Keep an offline copy together with your database backups.
