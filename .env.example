# Copy to .env before running Sögur Forge. Never commit the real .env file.
APP_PORT=3000
APP_URL=http://localhost:3000

# Generate long random values before exposing the app outside your local network.
POSTGRES_PASSWORD=replace-with-a-long-random-password
AUTH_SECRET=replace-with-at-least-32-random-bytes
DATABASE_URL=postgresql://sogur_forge:replace-with-a-long-random-password@localhost:5432/sogur_forge
