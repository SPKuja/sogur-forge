generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  sessionGeneration Int @default(1)
  totpEnabled Boolean @default(false)
  totpSecret String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  recoveryCodes RecoveryCode[]
  securityEvents SecurityEvent[]
  novels Novel[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  sessionGeneration Int
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  absoluteExpiresAt DateTime
  ipHash String?
  userAgent String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id String @id @default(cuid())
  codeHash String @unique
  userId String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SecurityEvent {
  id String @id @default(cuid())
  userId String?
  type String
  ipHash String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RateLimit {
  keyHash String @id
  attempts Int @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([userId, purpose])
  @@index([expiresAt])
}

model Novel {
  id String @id @default(cuid())
  userId String
  title String
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts Part[]
  chapters Chapter[]
  assets Asset[]
  stickyNotes StickyNote[]
  @@index([userId, updatedAt])
}

model Part {
  id String @id @default(cuid())
  novelId String
  title String
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  @@unique([novelId, position])
}

model Chapter {
  id String @id @default(cuid())
  novelId String
  partId String?
  title String
  content String @default("")
  summary String @default("")
  status String @default("DRAFT")
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)
  revisions ChapterRevision[]
  stickyNotes StickyNote[]
  @@unique([novelId, position])
  @@index([partId])
}

model ChapterRevision {
  id String @id @default(cuid())
  chapterId String
  title String
  content String
  createdAt DateTime @default(now())
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  @@index([chapterId, createdAt])
}

model Asset {
  id String @id @default(cuid())
  novelId String
  originalName String
  storedName String @unique
  mimeType String
  size Int
  createdAt DateTime @default(now())
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  @@index([novelId, createdAt])
}

model StickyNote {
  id String @id @default(cuid())
  novelId String
  chapterId String?
  body String @default("")
  color String @default("yellow")
  positionX Int @default(40)
  positionY Int @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  @@index([novelId, updatedAt])
  @@index([chapterId])
}
