generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id String @id @default(cuid())
  username String @unique
  email String @unique
  passwordHash String
  emailVerifiedAt DateTime?
  role String @default("USER")
  sessionGeneration Int @default(1)
  totpEnabled Boolean @default(false)
  totpSecret String?
  lastSeenVersion String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  recoveryCodes RecoveryCode[]
  securityEvents SecurityEvent[]
  verificationTokens VerificationToken[]
  backupDestinations BackupDestination[]
  backupOAuthStates BackupOAuthState[]
  novels Novel[]
  manuscriptViewPreferences ManuscriptViewPreference[]
}

model Session {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  sessionGeneration Int
  lastSeenAt DateTime @default(now())
  expiresAt DateTime
  absoluteExpiresAt DateTime
  ipHash String?
  userAgent String?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
  @@index([expiresAt])
}

model RecoveryCode {
  id String @id @default(cuid())
  codeHash String @unique
  userId String
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model SecurityEvent {
  id String @id @default(cuid())
  userId String?
  type String
  ipHash String?
  metadata Json?
  createdAt DateTime @default(now())
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model RateLimit {
  keyHash String @id
  attempts Int @default(0)
  windowStart DateTime @default(now())
  blockedUntil DateTime?
  updatedAt DateTime @updatedAt
}

model VerificationToken {
  id String @id @default(cuid())
  tokenHash String @unique
  userId String
  purpose String
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, purpose])
  @@index([expiresAt])
}


model AppSetting {
  id String @id
  registrationsEnabled Boolean @default(true)
  emailVerificationRequired Boolean @default(true)
  backupDownloadEnabled Boolean @default(true)
  backupDropboxEnabled Boolean @default(false)
  backupGoogleDriveEnabled Boolean @default(false)
  backupOneDriveEnabled Boolean @default(false)
  appBaseUrl String @default("")
  smtpHost String @default("")
  smtpPort Int @default(587)
  smtpSecure Boolean @default(false)
  smtpUser String @default("")
  smtpPasswordEncrypted String @default("")
  smtpFrom String @default("")
  googleDriveClientId String @default("")
  googleDriveClientSecretEncrypted String @default("")
  oneDriveClientId String @default("")
  oneDriveClientSecretEncrypted String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


model BackupDestination {
  id String @id @default(cuid())
  userId String
  provider String
  enabled Boolean @default(false)
  folder String @default("/Sögur Forge")
  accountLabel String @default("")
  providerAccountId String @default("")
  refreshTokenEncrypted String @default("")
  connectedAt DateTime?
  lastBackupAt DateTime?
  lastBackupError String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, provider])
  @@index([userId, enabled])
}


model BackupOAuthState {
  id String @id @default(cuid())
  stateHash String @unique
  userId String
  provider String
  verifierEncrypted String
  expiresAt DateTime
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, provider])
  @@index([expiresAt])
}

model Novel {
  id String @id @default(cuid())
  userId String
  title String
  description String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  parts Part[]
  chapters Chapter[]
  assets Asset[]
  stickyNotes StickyNote[]
  corkBoards CorkBoard[]
  characters Character[]
  characterRelationships CharacterRelationship[]
  locations Location[]
  worldNotes WorldNote[]
  chapterTemplates ChapterTemplate[]
  layout NovelLayout?
  manuscriptViewPreferences ManuscriptViewPreference[]
  @@index([userId, updatedAt])
}

model NovelLayout {
  novelId String @id
  settings Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
}

model ManuscriptViewPreference {
  userId String
  novelId String
  displayMode String @default("CONTINUOUS")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  @@id([userId, novelId])
  @@index([novelId])
}

model Part {
  id String @id @default(cuid())
  novelId String
  title String
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  chapters Chapter[]
  @@unique([novelId, position])
}

model Chapter {
  id String @id @default(cuid())
  novelId String
  partId String?
  title String
  kind String @default("CHAPTER")
  pageType String?
  content String @default("")
  summary String @default("")
  status String @default("DRAFT")
  templateId String?
  headerImageAssetId String?
  templateSeededAt DateTime?
  position Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  part Part? @relation(fields: [partId], references: [id], onDelete: SetNull)
  template ChapterTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  headerImageAsset Asset? @relation("ChapterHeaderAsset", fields: [headerImageAssetId], references: [id], onDelete: SetNull)
  revisions ChapterRevision[]
  stickyNotes StickyNote[]
  @@unique([novelId, position])
  @@index([partId])
  @@index([novelId, kind, position])
  @@index([templateId])
  @@index([headerImageAssetId])
}


model ChapterRevision {
  id String @id @default(cuid())
  chapterId String
  title String
  content String
  summary String @default("")
  status String @default("DRAFT")
  createdAt DateTime @default(now())
  chapter Chapter @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  @@index([chapterId, createdAt])
}

model Asset {
  id String @id @default(cuid())
  novelId String
  originalName String
  storedName String @unique
  mimeType String
  size Int
  createdAt DateTime @default(now())
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  characterImages CharacterImage[]
  locationImages LocationImage[]
  worldNoteImages WorldNoteImage[]
  chapterTemplateHeaders ChapterTemplate[] @relation("TemplateHeaderAsset")
  chapterHeaderOverrides Chapter[] @relation("ChapterHeaderAsset")
  @@index([novelId, createdAt])
}

model CorkBoard {
  id String @id @default(cuid())
  novelId String
  title String @default("Main Board")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  stickyNotes StickyNote[]
  @@index([novelId, position])
}

model StickyNote {
  id String @id @default(cuid())
  novelId String
  boardId String?
  chapterId String?
  anchorId String?
  anchorQuote String?
  body String @default("")
  color String @default("yellow")
  positionX Int @default(40)
  positionY Int @default(40)
  width Int @default(220)
  height Int @default(180)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  board CorkBoard? @relation(fields: [boardId], references: [id], onDelete: Cascade)
  chapter Chapter? @relation(fields: [chapterId], references: [id], onDelete: SetNull)
  @@index([novelId, updatedAt])
  @@index([boardId])
  @@index([chapterId])
  @@index([anchorId])
}


model Character {
  id String @id @default(cuid())
  novelId String
  name String @default("New Character")
  aliases String @default("")
  role String @default("")
  pronouns String @default("")
  age String @default("")
  description String @default("")
  appearance String @default("")
  personality String @default("")
  background String @default("")
  goals String @default("")
  conflict String @default("")
  arc String @default("")
  notes String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  images CharacterImage[]
  relationshipsFrom CharacterRelationship[] @relation("RelationshipSource")
  relationshipsTo CharacterRelationship[] @relation("RelationshipTarget")
  locationLinks LocationCharacterLink[]
  worldNoteLinks WorldNoteCharacterLink[]
  @@index([novelId, position])
  @@index([novelId, updatedAt])
}


model CharacterImage {
  id String @id @default(cuid())
  characterId String
  assetId String
  caption String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([characterId, assetId])
  @@index([characterId, position])
  @@index([assetId])
}


model CharacterRelationship {
  id String @id @default(cuid())
  novelId String
  sourceId String
  targetId String
  type String
  label String @default("")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  source Character @relation("RelationshipSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target Character @relation("RelationshipTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([novelId, sourceId, targetId, type])
  @@index([novelId])
  @@index([sourceId])
  @@index([targetId])
}


model Location {
  id String @id @default(cuid())
  novelId String
  parentId String?
  name String @default("New Location")
  aliases String @default("")
  type String @default("")
  region String @default("")
  description String @default("")
  atmosphere String @default("")
  history String @default("")
  significance String @default("")
  notes String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  parent Location? @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")
  images LocationImage[]
  characterLinks LocationCharacterLink[]
  worldNoteLinks WorldNoteLocationLink[]
  @@index([novelId, position])
  @@index([novelId, updatedAt])
  @@index([parentId])
}

model LocationImage {
  id String @id @default(cuid())
  locationId String
  assetId String
  caption String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([locationId, assetId])
  @@index([locationId, position])
  @@index([assetId])
}

model LocationCharacterLink {
  id String @id @default(cuid())
  locationId String
  characterId String
  type String @default("ASSOCIATED")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([locationId, characterId])
  @@index([locationId])
  @@index([characterId])
}

model WorldNote {
  id String @id @default(cuid())
  novelId String
  name String @default("New World Note")
  aliases String @default("")
  category String @default("Lore")
  summary String @default("")
  details String @default("")
  significance String @default("")
  notes String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  images WorldNoteImage[]
  characterLinks WorldNoteCharacterLink[]
  locationLinks WorldNoteLocationLink[]
  linksFrom WorldNoteRelation[] @relation("WorldNoteSource")
  linksTo WorldNoteRelation[] @relation("WorldNoteTarget")
  @@index([novelId, position])
  @@index([novelId, category])
  @@index([novelId, updatedAt])
}

model WorldNoteImage {
  id String @id @default(cuid())
  worldNoteId String
  assetId String
  caption String @default("")
  position Int @default(0)
  createdAt DateTime @default(now())
  worldNote WorldNote @relation(fields: [worldNoteId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Cascade)
  @@unique([worldNoteId, assetId])
  @@index([worldNoteId, position])
  @@index([assetId])
}

model WorldNoteCharacterLink {
  id String @id @default(cuid())
  worldNoteId String
  characterId String
  label String @default("Associated")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  worldNote WorldNote @relation(fields: [worldNoteId], references: [id], onDelete: Cascade)
  character Character @relation(fields: [characterId], references: [id], onDelete: Cascade)
  @@unique([worldNoteId, characterId])
  @@index([worldNoteId])
  @@index([characterId])
}

model WorldNoteLocationLink {
  id String @id @default(cuid())
  worldNoteId String
  locationId String
  label String @default("Associated")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  worldNote WorldNote @relation(fields: [worldNoteId], references: [id], onDelete: Cascade)
  location Location @relation(fields: [locationId], references: [id], onDelete: Cascade)
  @@unique([worldNoteId, locationId])
  @@index([worldNoteId])
  @@index([locationId])
}

model WorldNoteRelation {
  id String @id @default(cuid())
  sourceId String
  targetId String
  label String @default("Related")
  notes String @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  source WorldNote @relation("WorldNoteSource", fields: [sourceId], references: [id], onDelete: Cascade)
  target WorldNote @relation("WorldNoteTarget", fields: [targetId], references: [id], onDelete: Cascade)
  @@unique([sourceId, targetId])
  @@index([sourceId])
  @@index([targetId])
}

model ChapterTemplate {
  id String @id @default(cuid())
  novelId String
  name String
  isDefault Boolean @default(false)
  content String @default("")
  eyebrowPattern String @default("CHAPTER {{chapter_number}}")
  titlePattern String @default("{{chapter_title}}")
  showImage Boolean @default(false)
  headerImageAssetId String?
  imageWidth Int @default(100)
  imageAlign String @default("CENTER")
  imagePosition String @default("BEFORE_LABEL")
  imageSpacing Int @default(24)
  labelAlign String @default("CENTER")
  labelSize Int @default(10)
  labelWeight Int @default(800)
  labelFont String @default("SANS")
  labelSpacing Int @default(8)
  labelColor String @default("")
  labelCase String @default("UPPER")
  titleAlign String @default("CENTER")
  titleSize Int @default(42)
  titleWeight Int @default(700)
  titleFont String @default("SERIF")
  titleSpacing Int @default(22)
  titleColor String @default("")
  titleCase String @default("NORMAL")
  showDivider Boolean @default(true)
  dividerWidth Int @default(8)
  dividerThickness Int @default(1)
  headerPaddingTop Int @default(0)
  headerPaddingBottom Int @default(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  novel Novel @relation(fields: [novelId], references: [id], onDelete: Cascade)
  headerImageAsset Asset? @relation("TemplateHeaderAsset", fields: [headerImageAssetId], references: [id], onDelete: SetNull)
  chapters Chapter[]
  @@index([novelId, updatedAt])
  @@index([headerImageAssetId])
}
